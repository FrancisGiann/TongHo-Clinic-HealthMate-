{
  "name": "schoolcare-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "server": "node server.js",
    "db:migrate": "node server/migrate.js",
    "db:seed-demo": "node server/seed-demo.js",
    "test": "node --test server/*.test.js server/**/*.test.js src/utils/*.test.js",
    "check": "node --check server.js && node --check server/app.js && npm test && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest"
  }
}
