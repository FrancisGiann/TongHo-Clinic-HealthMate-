# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DEV_APP_URL=http://localhost:5173
COOKIE_SECURE=false
# Trust forwarded client IPs only after confirming the exact trusted reverse-proxy hop count.
# Hostinger may put the app behind a proxy; do not infer this value from X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Keep OTP enabled by default. REQUIRE_LOGIN_OTP=false is a local development override;
# production always requires OTP and refuses startup without verified database TLS and SMTP.
REQUIRE_LOGIN_OTP=true

# Supabase PostgreSQL connection (use the pooled connection string in production)
# Keep SSL query parameters out of DATABASE_URL; they override Pool TLS options.
DATABASE_URL=postgresql://postgres.project:password@host:6543/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Path to the bundled Supabase database CA certificate for verified TLS.
DB_SSL_CA_FILE=certificates/prod-ca-2021.crt
DB_POOL_MAX=10

# Optional private Supabase Storage for the two admin-managed brand images and
# consented incident photographs. Create a PRIVATE bucket; keep the service key server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=healthmate-private
INCIDENT_PHOTOS_ENABLED=false

# First administrator; used only by `npm run db:migrate` when no matching account exists
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu.ph
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# SMTP for OTP, invitations, password resets, and notifications
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
# Non-implicit SMTP connections require STARTTLS; certificate verification cannot be disabled in production.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=clinic@example.edu.ph
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM_NAME=HealthMate+
SMTP_FROM_EMAIL=clinic@example.edu.ph

# Automatic clinic reminders are disabled by default and production-only.
CLINIC_REMINDER_SCHEDULER_ENABLED=false
CLINIC_REMINDER_INTERVAL_HOURS=24
CLINIC_REMINDER_INITIAL_DELAY_MS=30000

# Completed daily, weekly, and monthly report archives are disabled by default.
# Manual snapshots are retained until an institution-approved retention policy exists.
REPORT_ARCHIVE_SCHEDULER_ENABLED=false
REPORT_ARCHIVE_INTERVAL_HOURS=6
REPORT_ARCHIVE_INITIAL_DELAY_MS=30000
REPORT_ARCHIVE_RETENTION_DAYS=730

# Optional provider-neutral AI summary endpoint. Used only when AI_SUMMARY_PROVIDER is blank.
# Leave both values blank for safe template summaries.
AI_SUMMARY_ENDPOINT=
AI_SUMMARY_API_KEY=
AI_SUMMARY_TIMEOUT_MS=10000

# Optional Google AI Studio Gemini adapter. It is fail-closed unless NODE_ENV=development
# and GEMINI_DEMO_MODE=true; use fictional demo content only. Never use real clinical data.
AI_SUMMARY_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DEMO_MODE=false
GEMINI_TIMEOUT_MS=10000

# Frontend uses same-origin /api in production. Set only when developing against another API origin.
VITE_API_BASE_URL=
