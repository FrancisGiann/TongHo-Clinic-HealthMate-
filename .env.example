# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DEV_APP_URL=http://localhost:5173
COOKIE_SECURE=false
REQUIRE_LOGIN_OTP=true

# Supabase PostgreSQL connection (use the pooled connection string in production)
DATABASE_URL=postgresql://postgres.project:password@host:6543/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Path to the bundled Supabase database CA certificate for verified TLS.
DB_SSL_CA_FILE=certificates/prod-ca-2021.crt
DB_POOL_MAX=10

# First administrator; used only by `npm run db:migrate` when no matching account exists
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu.ph
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# SMTP for OTP, invitations, password resets, and notifications
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=clinic@example.edu.ph
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM_NAME=HealthMate+
SMTP_FROM_EMAIL=clinic@example.edu.ph

# Optional provider-neutral AI summary endpoint. Leave blank for safe template summaries.
AI_SUMMARY_ENDPOINT=
AI_SUMMARY_API_KEY=
AI_SUMMARY_TIMEOUT_MS=10000

# Frontend uses same-origin /api in production. Set only when developing against another API origin.
VITE_API_BASE_URL=
